# Boot unattended with no CMOS battery and no hard disk.
#
# With no battery the BIOS already loads defaults every power-on (F000:217F):
# A: = 1.44 MB, B: none, no hard disks, 640 KB base memory, and
# "Boot from Flex Disk" on. But it then stops at
#   "** Battery Power Lost (Run SETUP)" / "Press <F1> for SETUP or <ENTER> to go on"
# and waits for a key forever.
#
# This patch:
#  1. Removes the factory burn-in trap (same as no_burnin.patch).
#  2. For the "battery lost / config not set / time not set / memory size"
#     prompt only: show the message, beep, wait up to ~3 s (or until a key is
#     pressed), then continue booting. F1 pressed during POST or during those
#     3 s still enters Setup (checked at F000:47C5).
#     Other errors (e.g. keyboard, disk failure) still stop as before.

# 1. burn-in trap: jne 4769 -> jmp 4769
F000:474F  0F 85 16 00  ->  E9 17 00 90

# 2a. at the F1 prompt, call our timed wait instead of the plain beep routine
#     call 4F60 (E8 DC 07) -> call 9F00 (E8 7C 57)     4784 + 577C = 9F00
F000:4781  E8 DC 07  ->  E8 7C 57

# 2b. after the wait, always continue: jne 47AF -> jmp 47AF + nop
#     4786 + 3 + 0026 = 47AF
F000:4786  0F 85 25 00  ->  E9 26 00 90

# 2c. new routine in free space F000:9F00 (was 00s)
#   9F00  E8 5D B0     call 4F60        ; original beeps   (9F03 + B05D = 4F60)
#   9F03  50           push ax
#   9F04  1E           push ds
#   9F05  53           push bx
#   9F06  FB           sti
#   9F07  B8 40 00     mov ax, 40h
#   9F0A  8E D8        mov ds, ax
#   9F0C  8B 1E 6C 00  mov bx, [6Ch]    ; BIOS tick count (18.2/s)
#   9F10  B4 01        mov ah, 1        ; L: key waiting?
#   9F12  CD 16        int 16h
#   9F14  75 0A        jnz 9F20         ; yes -> stop waiting (don't consume it)
#   9F16  A1 6C 00     mov ax, [6Ch]
#   9F19  2B C3        sub ax, bx
#   9F1B  83 F8 37     cmp ax, 55       ; ~3 seconds
#   9F1E  72 F0        jb 9F10
#   9F20  5B           pop bx
#   9F21  1F           pop ds
#   9F22  58           pop ax           ; AL (error flags) preserved for caller
#   9F23  C3           ret
F000:9F00  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00  ->  E8 5D B0 50 1E 53 FB B8 40 00 8E D8 8B 1E 6C 00
F000:9F10  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00  ->  B4 01 CD 16 75 0A A1 6C 00 2B C3 83 F8 37 72 F0
F000:9F20  00 00 00 00  ->  5B 1F 58 C3
