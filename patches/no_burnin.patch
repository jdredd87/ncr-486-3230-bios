# Never drop into NCR factory burn-in mode.
#
# Stock behaviour (F000:474C):
#     cmp ah, 0          ; AH = keyboard-controller input port (saved in 40:12)
#     jne loc_4769       ; normal: go on to the error / F1 prompt
#     mov [40:72], 5678h ; else: set burn-in marker ...
#     jmp POST           ; ... and reboot into burn-in mode
#
# 40:12 is forced to 0 at F000:3EA4 when the keyboard interface test returns
# code 3 and the keyboard clock/data lines don't read idle-high. That is how
# NCR detected its factory loopback plug. A faulty keyboard, adapter or blown
# keyboard fuse can do the same, and then the machine reboots into burn-in
# (memory errors halt, burn-in tests run) and F1 never works.
#
# Fix: make the branch unconditional, so we always reach the prompt.
#     jne rel16 (0F 85 16 00)  ->  jmp rel16 (E9 17 00) + nop (90)
#     474F + 3 + 0017h = 4769 (same target)
F000:474F  0F 85 16 00  ->  E9 17 00 90
